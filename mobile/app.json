{
  "expo": {
    "name": "Bê Wali",
    "slug": "be-wali",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF7F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "org.naxaci.bewali",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF7F6"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:4000/api"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Bê Wali a besoin d'accéder à tes photos pour choisir la photo du profil.",
          "cameraPermission": "Bê Wali a besoin de la caméra pour prendre ta photo à l'inscription."
        }
      ]
    ]
  }
}
