# Dev local (SQLite, zéro config)
DATABASE_URL="file:./dev.db"

# Pour la prod, remplacez par une vraie base Postgres et changez
# `provider = "sqlite"` -> `provider = "postgresql"` dans prisma/schema.prisma :
# DATABASE_URL="postgresql://user:password@host:5432/bewali"

JWT_SECRET="changez-moi-en-production-une-longue-chaine-aleatoire"
PORT=4000

# Premier compte administrateur (utilisé par `npm run seed`). Choisissez un mot de passe long et unique.
ADMIN_EMAIL="admin@exemple.org"
ADMIN_PASSWORD="changez-moi-svp-12+"
# Dossier des photos de profil des professionnelles (monter un disque persistant en production)
UPLOAD_DIR="./uploads"
DOWNLOAD_URL=            # lien de téléchargement de l APK (ex. GitHub Releases) ou du Play Store, utilisé par /telecharger
